    given-names: Qijun
    orcid: "https://orcid.org/0009-0008-5805-7727"
    affiliation: "SLAC National Accelerator Laboratory, Stanford University"
version: "1.0"
date-released: "2026-11-24"
url: "https://muchxs.streamlit.app/"
repository-code: "https://github.com/qijun-cloud/MuchXs-release"
keywords:
  - X-ray spectroscopy
  - charge-transfer multiplet theory
  - XAS
  - RIXS
  - resonant photoemission
  - transition metal oxides
